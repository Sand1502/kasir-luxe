# Salin jadi .env lalu sesuaikan. JANGAN commit berkas .env yang sudah terisi.

# Sambungan Postgres.
DATABASE_URL=postgresql://kasir:ganti-sandi-ini@localhost:5432/kasir

# Kata sandi untuk masuk ke aplikasi. WAJIB — peladen menolak jalan tanpa ini.
SANDI_TOKO=ganti-jadi-sesuatu-yang-panjang

# Kunci penanda sesi. Kalau kosong, dibuat acak tiap peladen dimulai — akibatnya
# semua orang ikut keluar tiap kali peladen dimulai ulang.
RAHASIA_SESI=

# Kata sandi peran basis data untuk konsol SQL. Kalau kosong, dibuat acak tiap
# boot; itu cukup untuk satu proses, tapi WAJIB diisi kalau prosesnya lebih dari
# satu — lihat catatan di src/db.js.
SANDI_PERAN_SQL=

# Setel 1 kalau disajikan lewat https, supaya kue sesi ditandai Secure.
PAKAI_HTTPS=0

PORT=3000

# Pagar konsol SQL.
SQL_MAKS_BARIS=500
SQL_BATAS_WAKTU=5000
SQL_SIMPAN_CADANGAN=20
